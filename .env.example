# Copia este archivo como .env y completa los valores. El archivo .env NO se sube a Git.
POSTGRES_USER=servilink
POSTGRES_DB=servilink
# Contraseña de la base (elige una propia; se puede usar cualquier carácter)
POSTGRES_PASSWORD=
# Clave para firmar los JWT: mínimo 32 caracteres, aleatoria y distinta de la de otros entornos
JWT_SECRET=
